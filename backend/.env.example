# SatRoad Mask Studio - Backend Configuration

# Bhoonidhi API Credentials (User registered on https://bhoonidhi.nrsc.gov.in)
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in

# Overpass API (OSM) Endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Backup Overpass endpoints if main is throttled:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
# OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache / Storage Directory
STORAGE_DIR=./data
MAX_AOI_AREA_DEG2=0.09  # ~0.3 x 0.3 degrees warning threshold
